<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only: the UI itself is Jetpack Compose (Theme.kt).
         Framework parent is used deliberately — there is no
         com.google.android.material dependency, so Theme.Material3.* is not
         available as an XML parent. -->
    <style name="Theme.ZeroTrace" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0D0D0D</item>
        <item name="android:colorBackground">#0D0D0D</item>
        <item name="android:statusBarColor">#0D0D0D</item>
        <item name="android:navigationBarColor">#0D0D0D</item>
        <item name="android:textColorPrimary">#E8E8E8</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
